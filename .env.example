# Credenciais do banco de dados (lado do navegador).
# Os nomes começam com VITE_ para o build publicá-las no bundle — é a chave
# pública, feita para isso. Os nomes foram mantidos como estavam para não
# quebrar o que já está configurado na hospedagem.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Endereço base das imagens do sistema (logos de partido, capa do check-in).
# Aponte para um domínio próprio ou CDN para que o domínio de quem hospeda os
# arquivos não apareça no HTML da página. Vazio usa o endereço atual.
VITE_MEDIA_BASE_URL=""

# Mesmo caso, para os arquivos da marca (logo do topo e da tela de login).
VITE_BRAND_MEDIA_BASE_URL=""

# Chave da base externa de onde vêm as fichas de vínculo de cliente.
# Fica só no servidor (sem o prefixo VITE_, para não ir para o bundle público)
# e é usada pela função /api/base-externa. Configure nas variáveis de ambiente
# da hospedagem. O nome foi mantido para não quebrar o que já está no ar.
NEXUS_PUBLIC_API_KEY=""

# Endereço do cadastro pelo QR Code.
# O cadastro tem domínio próprio, separado do painel: quem lê o QR Code nunca vê
# o endereço da área administrativa. Vazio usa o domínio embutido no código.
VITE_SIGNUP_BASE_URL=""

# Endereço do painel da equipe (o link que vai para o celular do integrante).
# Domínio próprio, separado do painel administrativo. Vazio usa o domínio
# embutido no código.
VITE_TEAM_BASE_URL=""
